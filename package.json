{
  "name": "photopip",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/sync-frame-dates.mjs && next dev",
    "prebuild": "node scripts/sync-frame-dates.mjs",
    "build": "node scripts/sync-frame-dates.mjs && next build && node scripts/package-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "deadcode": "knip",
    "audit:production": "node scripts/audit-production.mjs",
    "verify": "npm run format:check && npm run type-check && npm run lint && npm test && npm run deadcode && npm run audit:production && npm run build"
  },
  "dependencies": {
    "fabric": "7.4.0",
    "next": "^16.4.5",
    "next-themes": "0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "27.0.1",
    "knip": "^6.45.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
